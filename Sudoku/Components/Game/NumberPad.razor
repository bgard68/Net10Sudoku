<div class="numpad">
    @for (int n = 1; n <= 9; n++)
    {
        var num = n; // Local copy
        if (DigitDone[num])
        {
            <button class="btn num complete" disabled title="Completed">&#10003;</button>
        }
        else
        {
            <button class="btn num" disabled="@Disabled" @onclick="(() => OnPlace.InvokeAsync(num))" title="Place @num">@num</button>
        }
    }
    <button class="btn notes-toggle @(NotesMode ? "active" : "")"
            disabled="@Disabled"
            @onclick="OnToggleNotes"
            title="Toggle notes mode (N)"
            aria-pressed="@(NotesMode ? "true" : "false")">Notes</button>
    <button class="btn clear" disabled="@Disabled" @onclick="OnClear">Clear</button>
</div>

@code {
    [Parameter, EditorRequired] public bool[] DigitDone { get; set; } = default!;
    [Parameter] public bool NotesMode { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> OnPlace { get; set; }
    [Parameter] public EventCallback OnToggleNotes { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
}
