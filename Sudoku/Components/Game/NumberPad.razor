@* A 3x3 keypad of the digits 1-9. A digit correctly placed nine times turns
   into a quiet check tile instead of a disabled button. *@
<div class="keypad">
    @for (int n = 1; n <= 9; n++)
    {
        var num = n; // Local copy
        if (DigitDone[num])
        {
            <button class="keytile complete" disabled title="Completed">&#10003;</button>
        }
        else
        {
            <button class="keytile" disabled="@Disabled" @onclick="(() => OnPlace.InvokeAsync(num))" title="Place @num">@num</button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public bool[] DigitDone { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> OnPlace { get; set; }
}
