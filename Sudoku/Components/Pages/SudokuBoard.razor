@page "/"
@using Sudoku.Application.Interfaces
@using Sudoku.Application.Models
@using Sudoku.Domain
@using Sudoku.Services
@inject IGameService Sudoku
@inject ThemeService ThemeService
@inject GameStorage Storage
@implements IDisposable

<PageTitle>Sudoku Game</PageTitle>

@{
    // Conflicts and completed digits are derived once per render instead of per
    // cell: the old per-cell scans cost ~5,000 board reads every render pass.
    var view = BuildView();
}

<div class="sudoku-root @(ThemeService.IsDarkMode ? "dark-mode" : "")" @onmouseup="OnMouseUp">
    <div class="toolbar">
        <button class="btn diff easy" disabled="@isGenerating" @onclick="(() => NewGame(Difficulty.Easy))">Easy</button>
        <button class="btn diff med" disabled="@isGenerating" @onclick="(() => NewGame(Difficulty.Medium))">Medium</button>
        <button class="btn diff hard" disabled="@isGenerating" @onclick="(() => NewGame(Difficulty.Hard))">Hard</button>
        <button class="btn diff pro" disabled="@isGenerating" @onclick="(() => NewGame(Difficulty.Professional))">Professional</button>
        <span class="spacer"></span>
        <button class="btn action undo" disabled="@(isGenerating || !Sudoku.CanUndo)" @onclick="Undo" title="Undo last action">Undo</button>
        <button class="btn action redo" disabled="@(isGenerating || !Sudoku.CanRedo)" @onclick="Redo" title="Redo undone action">Redo</button>
        <button class="btn action validate" disabled="@isGenerating" @onclick="Validate">Validate</button>
        <button class="btn action hint" disabled="@isGenerating" @onclick="ApplyHint">Hint</button>
        <button class="btn action solve" disabled="@isGenerating" @onclick="Solve">Solve</button>
        <button class="btn action clear-all" disabled="@isGenerating" @onclick="ClearAll">Clear All</button>
    </div>

    @* One tab stop for the whole grid; arrows move the active cell and
       aria-activedescendant tells assistive tech which cell that is. *@
    <div class="board @(isSolved ? "celebration" : "")"
         role="grid"
         tabindex="0"
         aria-label="Sudoku grid"
         aria-activedescendant="@ActiveDescendant"
         @key="boardKey"
         @onkeydown="HandleGridKeyDown"
         @onmouseleave="EndDrag">
        @for (var row = 0; row < 9; row++)
        {
            var r = row;
            <div class="srow" role="row">
                @for (var col = 0; col < 9; col++)
                {
                    var c = col;
                    var cell = Sudoku.Current[r, c];
                    <div id="@CellId(r, c)"
                         class="@GetCellClasses(r, c, view)"
                         role="gridcell"
                         aria-selected="@(IsSelected(r, c) ? "true" : "false")"
                         aria-readonly="@(cell.IsGiven ? "true" : "false")"
                         aria-label="@CellLabel(r, c)"
                         @onclick="@(() => HandleClick(r, c))"
                         @onpointerdown="@(() => HandlePointerDown(r, c))"
                         @onpointerenter="@(() => HandlePointerEnter(r, c))">
                    @if (cell.Value is int val)
                    {
                        <span>@val</span>
                    }
                    else if (cell.Notes.Count > 0)
                    {
                        <div class="notes" aria-hidden="true">
                            @for (int d = 1; d <= 9; d++)
                            {
                                <span class="note">@(cell.HasNote(d) ? d.ToString() : "")</span>
                            }
                        </div>
                    }
                    </div>
                }
            </div>
        }
        @if (Sudoku.Selected is Position sel)
        {
            var blockRow = (sel.Row / 3) * 3;
            var blockCol = (sel.Col / 3) * 3;
            var topPx = blockRow * 52 + blockRow; // add 1px per preceding row border
            var leftPx = blockCol * 52 + blockCol;
            <div class="block-overlay" style="top:@(topPx)px;left:@(leftPx)px;"></div>
        }
    </div>

    <NumberPad DigitDone="view.DigitDone"
               NotesMode="Sudoku.NotesMode"
               Disabled="isGenerating"
               OnPlace="Place"
               OnToggleNotes="ToggleNotes"
               OnClear="Clear" />

    <GameStatusBar TimeDisplay="@TimeDisplay"
                   BestDisplay="@BestDisplay"
                   Mistakes="Sudoku.Mistakes"
                   SelectedText="@SelectedText"
                   NotesMode="Sudoku.NotesMode" />

    @if (isSolved)
    {
        <WinBanner TimeDisplay="@TimeDisplay"
                   NewBest="newBest"
                   AutoSolved="usedAutoSolve"
                   BestDisplay="@BestDisplay"
                   Mistakes="Sudoku.Mistakes" />
        <Celebration />
    }

    @if (message is not null && !isSolved)
    {
        <div class="message">@message</div>
    }
</div>

@code {
    private sealed record BoardView(bool[,] Conflicts, bool[] DigitDone);

    private bool isDragging;
    private bool isGenerating;
    private string? message;
    private int boardKey = 0;
    private bool isSolved = false;
    private Difficulty currentDifficulty = Difficulty.Easy;
    private System.Timers.Timer? clock;
    private DateTime startedUtc = DateTime.UtcNow;
    private TimeSpan elapsed;
    private int clockTicks;
    private TimeSpan? bestTime;
    private bool newBest;
    private bool usedAutoSolve;

    private string TimeDisplay => Format(elapsed);
    private string? BestDisplay => bestTime is TimeSpan best ? Format(best) : null;
    private string SelectedText => Sudoku.Selected is Position sp ? $"({sp.Row + 1},{sp.Col + 1})" : "none";
    private static string Format(TimeSpan t) => $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
    private string? ActiveDescendant => Sudoku.Selected is Position p ? CellId(p.Row, p.Col) : null;
    private static string CellId(int r, int c) => $"cell-{r}-{c}";

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;

        clock = new System.Timers.Timer(500);
        // The Elapsed callback fires on a timer thread; all component state is
        // touched inside InvokeAsync so it stays on the renderer's context.
        clock.Elapsed += (_, _) => _ = InvokeAsync(() =>
        {
            if (isSolved || isGenerating) return;
            elapsed = DateTime.UtcNow - startedUtc;
            // Persist the running clock every ~10s so a refresh loses at most that.
            if (++clockTicks % 20 == 0) _ = PersistAsync();
            StateHasChanged();
        });
        clock.Start();
    }

    // Browser storage needs JS interop, which is unavailable until after the first
    // interactive render - so game start (restore or fresh puzzle) happens here.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await Storage.LoadGameAsync();
        if (saved is not null && TryRestore(saved))
        {
            await LoadBestAsync(currentDifficulty);
            StateHasChanged();
            return;
        }

        await NewGame(Difficulty.Easy);
        StateHasChanged();
    }

    private bool TryRestore(GameSnapshot saved)
    {
        try
        {
            // ToBoard throws on malformed data; stored state is outside our
            // control, so any failure just means "no saved game".
            var board = saved.ToBoard();
            Sudoku.Restore(board, saved.Mistakes);
            currentDifficulty = saved.Difficulty;
            elapsed = TimeSpan.FromSeconds(Math.Max(0, saved.ElapsedSeconds));
            startedUtc = DateTime.UtcNow - elapsed;
            isSolved = false;
            boardKey++;
            message = "Restored your saved game.";
            return true;
        }
        catch
        {
            return false;
        }
    }

    private Task PersistAsync() => isSolved
        ? Storage.ClearGameAsync()
        : Storage.SaveGameAsync(GameSnapshot.Capture(Sudoku.Current, elapsed, currentDifficulty, Sudoku.Mistakes));

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        clock?.Dispose();
    }

    async Task NewGame(Difficulty d)
    {
        if (isGenerating) return;
        isGenerating = true;
        isSolved = false;
        message = $"Generating {d} puzzle...";
        StateHasChanged();

        await Sudoku.NewAsync(d);

        isGenerating = false;
        currentDifficulty = d;
        boardKey++;
        startedUtc = DateTime.UtcNow;
        elapsed = TimeSpan.Zero;
        newBest = false;
        usedAutoSolve = false;
        message = $"New {d} puzzle generated.";
        await PersistAsync();
        await LoadBestAsync(d);
    }

    private async Task LoadBestAsync(Difficulty d)
    {
        var seconds = await Storage.LoadBestSecondsAsync(d);
        bestTime = seconds is int s ? TimeSpan.FromSeconds(s) : null;
    }

    void HandleClick(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return;
        Sudoku.Select(r, c);
    }

    void HandlePointerDown(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return;
        isDragging = true;
        Sudoku.Select(r, c);
    }

    void HandlePointerEnter(int r, int c)
    {
        if (!isDragging || r < 0 || r >= 9 || c < 0 || c >= 9) return;
        Sudoku.Select(r, c);
    }

    void Place(int n)
    {
        if (isGenerating) return;
        Sudoku.Place(n);
        CheckIfSolved();
        _ = PersistAsync();
    }

    void Clear()
    {
        if (isGenerating) return;
        Sudoku.Clear();
        isSolved = false;
        _ = PersistAsync();
    }

    void ClearAll()
    {
        Sudoku.ClearAll();
        message = "All user entries cleared.";
        isSolved = false;
        _ = PersistAsync();
    }

    void Undo()
    {
        Sudoku.Undo();
        isSolved = false;
        _ = PersistAsync();
    }

    void Redo()
    {
        Sudoku.Redo();
        CheckIfSolved();
        _ = PersistAsync();
    }

    void ToggleNotes()
    {
        Sudoku.ToggleNotesMode();
    }

    void Validate()
    {
        bool isValid = Sudoku.Validate();
        if (isValid && Sudoku.IsComplete())
        {
            MarkSolved();
        }
        else
        {
            message = isValid ? "Board is valid so far." : "There are conflicts.";
        }
    }

    void CheckIfSolved()
    {
        if (Sudoku.IsComplete())
        {
            MarkSolved();
        }
    }

    void MarkSolved()
    {
        isSolved = true;
        message = null;
        elapsed = DateTime.UtcNow - startedUtc;

        // Auto-solved games never set records - the record belongs to the player.
        if (!usedAutoSolve && (bestTime is null || elapsed < bestTime))
        {
            newBest = true;
            bestTime = elapsed;
            _ = Storage.SaveBestSecondsAsync(currentDifficulty, (int)elapsed.TotalSeconds);
        }
    }

    void ApplyHint()
    {
        if (Sudoku.Selected is null)
        {
            message = "Please select a cell first to get a hint.";
            return;
        }

        var hint = Sudoku.GetHintForSelectedCell();

        if (hint is null)
        {
            var cell = Sudoku.Current[Sudoku.Selected.Value.Row, Sudoku.Selected.Value.Col];
            if (cell.IsGiven)
            {
                message = "Cannot provide hint for given cells.";
            }
            else
            {
                message = "Unable to determine hint for this cell.";
            }
            return;
        }

        Sudoku.ApplyHintForSelectedCell();
        message = $"Hint: placed {hint.Value.value} in the selected cell";

        CheckIfSolved();
        _ = PersistAsync();
    }

    void Solve()
    {
        usedAutoSolve = true;
        bool solved = Sudoku.Solve();
        if (solved)
        {
            MarkSolved();
        }
        else
        {
            message = "No solution.";
        }
        _ = PersistAsync();
    }

    void EndDrag()
    {
        isDragging = false;
    }

    void OnMouseUp(MouseEventArgs _)
    {
        isDragging = false;
    }

    void HandleGridKeyDown(KeyboardEventArgs e)
    {
        if (isGenerating || e.Key is null) return;

        var pos = Sudoku.Selected ?? new Position(0, 0);
        switch (e.Key)
        {
            case "ArrowUp": Sudoku.Select(Math.Max(0, pos.Row - 1), pos.Col); return;
            case "ArrowDown": Sudoku.Select(Math.Min(8, pos.Row + 1), pos.Col); return;
            case "ArrowLeft": Sudoku.Select(pos.Row, Math.Max(0, pos.Col - 1)); return;
            case "ArrowRight": Sudoku.Select(pos.Row, Math.Min(8, pos.Col + 1)); return;
            case "Backspace" or "Delete":
                if (Sudoku.Selected is not null) Clear();
                return;
            case "n" or "N": ToggleNotes(); return;
        }

        if (int.TryParse(e.Key, out var n) && n is >= 1 and <= 9 && Sudoku.Selected is not null)
        {
            Place(n);
        }
    }

    bool IsSelected(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return false;
        return Sudoku.Selected?.Row == r && Sudoku.Selected?.Col == c;
    }

    string CellLabel(int r, int c)
    {
        var cell = Sudoku.Current[r, c];
        var what = cell.Value is int v
            ? cell.IsGiven ? $"{v}, given" : $"{v}"
            : cell.Notes.Count > 0
                ? $"empty, notes {string.Join(" ", cell.Notes.OrderBy(x => x))}"
                : "empty";
        return $"Row {r + 1}, column {c + 1}, {what}";
    }

    // One O(81) pass over the board yields per-unit digit counts, which answer both
    // "is this cell in conflict?" and "is this digit finished?" in O(1) afterwards.
    BoardView BuildView()
    {
        var rowCount = new int[9, 10];
        var colCount = new int[9, 10];
        var boxCount = new int[9, 10];

        for (int r = 0; r < 9; r++)
        for (int c = 0; c < 9; c++)
        {
            if (Sudoku.Current[r, c].Value is int v)
            {
                rowCount[r, v]++;
                colCount[c, v]++;
                boxCount[r / 3 * 3 + c / 3, v]++;
            }
        }

        var conflicts = new bool[9, 9];
        for (int r = 0; r < 9; r++)
        for (int c = 0; c < 9; c++)
        {
            if (Sudoku.Current[r, c].Value is int v)
                conflicts[r, c] = rowCount[r, v] > 1 || colCount[c, v] > 1 || boxCount[r / 3 * 3 + c / 3, v] > 1;
        }

        var done = new bool[10];
        for (int v = 1; v <= 9; v++)
        {
            done[v] = true;
            for (int k = 0; k < 9 && done[v]; k++)
            {
                if (rowCount[k, v] != 1 || colCount[k, v] != 1 || boxCount[k, v] != 1)
                    done[v] = false;
            }
        }

        return new BoardView(conflicts, done);
    }

    string GetCellClasses(int r, int c, BoardView view)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return "cell";
        var cell = Sudoku.Current[r, c];
        bool isSelected = IsSelected(r, c);
        bool sameRow = Sudoku.Selected?.Row == r;
        bool sameCol = Sudoku.Selected?.Col == c;
        bool hasConflict = view.Conflicts[r, c];
        bool sameBlock = false;
        bool sameValue = false;
        if (Sudoku.Selected is Position sp)
        {
            sameBlock = (r / 3 == sp.Row / 3) && (c / 3 == sp.Col / 3);
            var selectedVal = Sudoku.Current[sp.Row, sp.Col].Value;
            if (selectedVal is int sv && cell.Value is int cv && sv == cv)
            {
                sameValue = true;
            }
        }
        string borderClasses = (r % 3 == 0 ? " top3" : "") + (c % 3 == 0 ? " left3" : "") + (r == 8 ? " bottom3" : "") + (c == 8 ? " right3" : "");
        return $"cell{(cell.IsGiven ? " given" : "")}{(isSelected ? " selected" : "")}{(sameRow ? " rowhl" : "")}{(sameCol ? " colhl" : "")}{(sameBlock ? " blockhl" : "")}{(sameValue ? " valhl" : "")}{(hasConflict ? " conflict" : "")}{borderClasses}";
    }

}
