@page "/"
@using Sudoku.Application.Interfaces
@using Sudoku.Application.Models
@using Sudoku.Application.Services
@using Sudoku.Domain
@inject IGameService Sudoku
@inject GameSession Session
@implements IDisposable

<PageTitle>Sudoku Game</PageTitle>

@{
    // Conflicts and completed digits are derived once per render instead of per
    // cell: the old per-cell scans cost ~5,000 board reads every render pass.
    var view = BuildView();
}

<div class="sudoku-root" style="@RootStyle" @onmouseup="OnMouseUp">
    <div class="top-strip">
        @* The filled pill doubles as the current-difficulty indicator; clicking
           any pill starts a new game at that level. *@
        <div class="pill-row" role="group" aria-label="New game difficulty">
            <button class="pill easy @(ActivePill(Difficulty.Easy))" disabled="@Session.IsGenerating" @onclick="(() => NewGame(Difficulty.Easy))" title="New Easy game">Easy</button>
            <button class="pill med @(ActivePill(Difficulty.Medium))" disabled="@Session.IsGenerating" @onclick="(() => NewGame(Difficulty.Medium))" title="New Medium game">Medium</button>
            <button class="pill hard @(ActivePill(Difficulty.Hard))" disabled="@Session.IsGenerating" @onclick="(() => NewGame(Difficulty.Hard))" title="New Hard game">Hard</button>
            <button class="pill pro @(ActivePill(Difficulty.Professional))" disabled="@Session.IsGenerating" @onclick="(() => NewGame(Difficulty.Professional))" title="New Professional game">Pro</button>
        </div>
        <GameStatusBar TimeDisplay="@TimeDisplay"
                       BestDisplay="@BestDisplay"
                       Mistakes="Sudoku.Mistakes" />
    </div>

    <div class="play-area">
    @* One tab stop for the whole grid; arrows move the active cell and
       aria-activedescendant tells assistive tech which cell that is. *@
    <div class="board @(Session.IsSolved ? "celebration" : "")"
         role="grid"
         tabindex="0"
         aria-label="Sudoku grid"
         aria-activedescendant="@ActiveDescendant"
         @key="Session.BoardVersion"
         @onkeydown="HandleGridKeyDown"
         @onmouseleave="EndDrag">
        @for (var row = 0; row < 9; row++)
        {
            var r = row;
            <div class="srow" role="row">
                @for (var col = 0; col < 9; col++)
                {
                    var c = col;
                    var cell = Sudoku.Current[r, c];
                    <div id="@CellId(r, c)"
                         class="@GetCellClasses(r, c, view)"
                         role="gridcell"
                         aria-selected="@(IsSelected(r, c) ? "true" : "false")"
                         aria-readonly="@(cell.IsGiven ? "true" : "false")"
                         aria-label="@CellLabel(r, c)"
                         @onclick="@(() => HandleClick(r, c))"
                         @onpointerdown="@(() => HandlePointerDown(r, c))"
                         @onpointerenter="@(() => HandlePointerEnter(r, c))">
                    @if (cell.Value is int val)
                    {
                        <span>@val</span>
                    }
                    else if (cell.Notes.Count > 0)
                    {
                        <div class="notes" aria-hidden="true">
                            @for (int d = 1; d <= 9; d++)
                            {
                                <span class="note">@(cell.HasNote(d) ? d.ToString() : "")</span>
                            }
                        </div>
                    }
                    </div>
                }
            </div>
        }
        @if (Sudoku.Selected is Position sel)
        {
            var blockRow = (sel.Row / 3) * 3;
            var blockCol = (sel.Col / 3) * 3;
            var topPx = blockRow * 52 + blockRow; // add 1px per preceding row border
            var leftPx = blockCol * 52 + blockCol;
            <div class="block-overlay" style="top:@(topPx)px;left:@(leftPx)px;"></div>
        }
    </div>

    <div class="side-panel">
        <div class="tile-grid" role="toolbar" aria-label="Game actions">
            <button class="tile undo" disabled="@(Session.IsGenerating || !Sudoku.CanUndo)" @onclick="Undo" title="Undo last action">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
                <span>Undo</span>
            </button>
            <button class="tile redo" disabled="@(Session.IsGenerating || !Sudoku.CanRedo)" @onclick="Redo" title="Redo undone action">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>
                <span>Redo</span>
            </button>
            <button class="tile erase" disabled="@Session.IsGenerating" @onclick="Clear" title="Erase the selected cell">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21H7Z"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg>
                <span>Erase</span>
            </button>
            <button class="tile notes" disabled="@Session.IsGenerating" @onclick="ToggleNotes"
                    title="Toggle notes mode (N)" aria-pressed="@(Sudoku.NotesMode ? "true" : "false")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                <span>Notes</span>
                <span class="mini-switch @(Sudoku.NotesMode ? "on" : "")" aria-hidden="true"><span class="knob"></span></span>
            </button>
        </div>

        <NumberPad DigitDone="view.DigitDone"
                   Disabled="Session.IsGenerating"
                   OnPlace="Place" />

        <button class="bigbtn validate" disabled="@Session.IsGenerating" @onclick="Validate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            Validate
        </button>
        <button class="bigbtn hint" disabled="@Session.IsGenerating" @onclick="ApplyHint" title="Reveal the selected cell">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            Hint
        </button>
        <button class="bigbtn solve" disabled="@Session.IsGenerating" @onclick="Solve">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>
            Solve
        </button>

        <div class="link-row">
            <button class="linkbtn" disabled="@Session.IsGenerating" @onclick="ClearAll">Clear all</button>
        </div>

        <div class="customize">
            <button class="customize-header" @onclick="(() => customizeOpen = !customizeOpen)" aria-expanded="@(customizeOpen ? "true" : "false")">
                Customize colors <span class="chev">@(customizeOpen ? "▾" : "▸")</span>
            </button>
            @if (customizeOpen)
            {
                <div class="wheel-list">
                    <div class="wheel-row">
                        <label class="wheel" title="Pick a background colour">
                            <input type="color" value="@pageBg" @onchange="@(e => pageBg = SanitizeHex(e.Value?.ToString(), DefaultPageBg))" />
                        </label>
                        <div class="wheel-meta"><span class="wheel-name">Background</span><span class="swatch" style="background:@pageBg">@pageBg</span></div>
                    </div>
                    <div class="wheel-row">
                        <label class="wheel" title="Pick a grid background colour">
                            <input type="color" value="@gridBg" @onchange="@(e => gridBg = SanitizeHex(e.Value?.ToString(), DefaultGridBg))" />
                        </label>
                        <div class="wheel-meta"><span class="wheel-name">Grid background</span><span class="swatch" style="background:@gridBg">@gridBg</span></div>
                    </div>
                    <div class="wheel-row">
                        <label class="wheel" title="Pick a grid border colour">
                            <input type="color" value="@gridBorder" @onchange="@(e => gridBorder = SanitizeHex(e.Value?.ToString(), DefaultGridBorder))" />
                        </label>
                        <div class="wheel-meta"><span class="wheel-name">Grid borders</span><span class="swatch" style="background:@gridBorder">@gridBorder</span></div>
                    </div>
                    <div class="wheel-row">
                        <label class="wheel" title="Pick a grid number colour">
                            <input type="color" value="@gridNum" @onchange="@(e => gridNum = SanitizeHex(e.Value?.ToString(), DefaultGridNum))" />
                        </label>
                        <div class="wheel-meta"><span class="wheel-name">Grid numbers</span><span class="swatch" style="background:@gridNum">@gridNum</span></div>
                    </div>
                    <button class="linkbtn" @onclick="ResetColors">Reset to defaults</button>
                </div>
            }
        </div>
    </div>
    </div>

    @if (Session.IsSolved)
    {
        <WinBanner TimeDisplay="@TimeDisplay"
                   NewBest="Session.NewBest"
                   AutoSolved="Session.UsedAutoSolve"
                   BestDisplay="@BestDisplay"
                   Mistakes="Sudoku.Mistakes" />
        <Celebration />
    }

    @if (Session.Message is not null && !Session.IsSolved)
    {
        <div class="message">@Session.Message</div>
    }
</div>

@code {
    private sealed record BoardView(bool[,] Conflicts, bool[] DigitDone);

    private bool isDragging;
    private System.Timers.Timer? clock;

    // Board colour customisation. Only the board and page canvas are themed;
    // every control keeps its own fixed backdrop and text colours, so no
    // combination of picks can make the controls unreadable.
    private const string DefaultPageBg = "#0a0a0a";
    private const string DefaultGridBg = "#1a1a1a";
    private const string DefaultGridBorder = "#39ff14";
    private const string DefaultGridNum = "#ffffff";

    private bool customizeOpen;
    private string pageBg = DefaultPageBg;
    private string gridBg = DefaultGridBg;
    private string gridBorder = DefaultGridBorder;
    private string gridNum = DefaultGridNum;

    // These values land in a style attribute, so never trust them raw: anything
    // that is not a #rrggbb hex collapses back to the default.
    private static string SanitizeHex(string? value, string fallback) =>
        value is not null && System.Text.RegularExpressions.Regex.IsMatch(value, "^#[0-9a-fA-F]{6}$")
            ? value
            : fallback;

    private string RootStyle =>
        $"--page-bg:{pageBg};--grid-bg:{gridBg};--grid-border:{gridBorder};--grid-num:{gridNum}";

    private void ResetColors()
    {
        pageBg = DefaultPageBg;
        gridBg = DefaultGridBg;
        gridBorder = DefaultGridBorder;
        gridNum = DefaultGridNum;
    }

    private string TimeDisplay => Format(Session.Elapsed);
    private string? BestDisplay => Session.BestTime is TimeSpan best ? Format(best) : null;
    private string ActivePill(Difficulty d) => Session.CurrentDifficulty == d ? "active" : "";
    private static string Format(TimeSpan t) => $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
    private string? ActiveDescendant => Sudoku.Selected is Position p ? CellId(p.Row, p.Col) : null;
    private static string CellId(int r, int c) => $"cell-{r}-{c}";

    protected override void OnInitialized()
    {
        clock = new System.Timers.Timer(500);
        // The Elapsed callback fires on a timer thread; everything runs inside
        // InvokeAsync so state is only touched on the renderer's context.
        clock.Elapsed += (_, _) => _ = InvokeAsync(async () =>
        {
            await Session.TickAsync();
            StateHasChanged();
        });
        clock.Start();
    }

    // Browser storage needs JS interop, which is unavailable until after the first
    // interactive render - so game start (restore or fresh puzzle) happens here.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.InitializeAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        clock?.Dispose();
    }

    async Task NewGame(Difficulty d)
    {
        await Session.StartNewAsync(d);
    }

    void HandleClick(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return;
        Sudoku.Select(r, c);
    }

    void HandlePointerDown(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return;
        isDragging = true;
        Sudoku.Select(r, c);
    }

    void HandlePointerEnter(int r, int c)
    {
        if (!isDragging || r < 0 || r >= 9 || c < 0 || c >= 9) return;
        Sudoku.Select(r, c);
    }

    void Place(int n)
    {
        if (Session.IsGenerating) return;
        Sudoku.Place(n);
        CheckIfSolved();
        _ = Session.PersistAsync();
    }

    void Clear()
    {
        if (Session.IsGenerating) return;
        Sudoku.Clear();
        Session.ResetSolved();
        _ = Session.PersistAsync();
    }

    void ClearAll()
    {
        Sudoku.ClearAll();
        Session.Message = "All user entries cleared.";
        Session.ResetSolved();
        _ = Session.PersistAsync();
    }

    void Undo()
    {
        Sudoku.Undo();
        Session.ResetSolved();
        _ = Session.PersistAsync();
    }

    void Redo()
    {
        Sudoku.Redo();
        CheckIfSolved();
        _ = Session.PersistAsync();
    }

    void ToggleNotes()
    {
        Sudoku.ToggleNotesMode();
    }

    void Validate()
    {
        bool isValid = Sudoku.Validate();
        if (isValid && Sudoku.IsComplete())
        {
            Session.MarkSolved();
        }
        else
        {
            Session.Message = isValid ? "Board is valid so far." : "There are conflicts.";
        }
    }

    void CheckIfSolved()
    {
        if (Sudoku.IsComplete())
        {
            Session.MarkSolved();
        }
    }

    void ApplyHint()
    {
        if (Sudoku.Selected is null)
        {
            Session.Message = "Please select a cell first to get a hint.";
            return;
        }

        var hint = Sudoku.GetHintForSelectedCell();

        if (hint is null)
        {
            var cell = Sudoku.Current[Sudoku.Selected.Value.Row, Sudoku.Selected.Value.Col];
            Session.Message = cell.IsGiven
                ? "Cannot provide hint for given cells."
                : "Unable to determine hint for this cell.";
            return;
        }

        Sudoku.ApplyHintForSelectedCell();
        Session.Message = $"Hint: placed {hint.Value.value} in the selected cell";

        CheckIfSolved();
        _ = Session.PersistAsync();
    }

    void Solve()
    {
        Session.MarkAutoSolveUsed();
        if (Sudoku.Solve())
        {
            Session.MarkSolved();
        }
        else
        {
            Session.Message = "No solution.";
        }
        _ = Session.PersistAsync();
    }

    void EndDrag()
    {
        isDragging = false;
    }

    void OnMouseUp(MouseEventArgs _)
    {
        isDragging = false;
    }

    void HandleGridKeyDown(KeyboardEventArgs e)
    {
        if (Session.IsGenerating || e.Key is null) return;

        var pos = Sudoku.Selected ?? new Position(0, 0);
        switch (e.Key)
        {
            case "ArrowUp": Sudoku.Select(Math.Max(0, pos.Row - 1), pos.Col); return;
            case "ArrowDown": Sudoku.Select(Math.Min(8, pos.Row + 1), pos.Col); return;
            case "ArrowLeft": Sudoku.Select(pos.Row, Math.Max(0, pos.Col - 1)); return;
            case "ArrowRight": Sudoku.Select(pos.Row, Math.Min(8, pos.Col + 1)); return;
            case "Backspace" or "Delete":
                if (Sudoku.Selected is not null) Clear();
                return;
            case "n" or "N": ToggleNotes(); return;
        }

        if (int.TryParse(e.Key, out var n) && n is >= 1 and <= 9 && Sudoku.Selected is not null)
        {
            Place(n);
        }
    }

    bool IsSelected(int r, int c)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return false;
        return Sudoku.Selected?.Row == r && Sudoku.Selected?.Col == c;
    }

    string CellLabel(int r, int c)
    {
        var cell = Sudoku.Current[r, c];
        var what = cell.Value is int v
            ? cell.IsGiven ? $"{v}, given" : $"{v}"
            : cell.Notes.Count > 0
                ? $"empty, notes {string.Join(" ", cell.Notes.OrderBy(x => x))}"
                : "empty";
        return $"Row {r + 1}, column {c + 1}, {what}";
    }

    // One O(81) pass over the board yields per-unit digit counts, which answer both
    // "is this cell in conflict?" and "is this digit finished?" in O(1) afterwards.
    BoardView BuildView()
    {
        var rowCount = new int[9, 10];
        var colCount = new int[9, 10];
        var boxCount = new int[9, 10];

        for (int r = 0; r < 9; r++)
        for (int c = 0; c < 9; c++)
        {
            if (Sudoku.Current[r, c].Value is int v)
            {
                rowCount[r, v]++;
                colCount[c, v]++;
                boxCount[r / 3 * 3 + c / 3, v]++;
            }
        }

        var conflicts = new bool[9, 9];
        for (int r = 0; r < 9; r++)
        for (int c = 0; c < 9; c++)
        {
            if (Sudoku.Current[r, c].Value is int v)
                conflicts[r, c] = rowCount[r, v] > 1 || colCount[c, v] > 1 || boxCount[r / 3 * 3 + c / 3, v] > 1;
        }

        var done = new bool[10];
        for (int v = 1; v <= 9; v++)
        {
            done[v] = true;
            for (int k = 0; k < 9 && done[v]; k++)
            {
                if (rowCount[k, v] != 1 || colCount[k, v] != 1 || boxCount[k, v] != 1)
                    done[v] = false;
            }
        }

        return new BoardView(conflicts, done);
    }

    string GetCellClasses(int r, int c, BoardView view)
    {
        if (r < 0 || r >= 9 || c < 0 || c >= 9) return "cell";
        var cell = Sudoku.Current[r, c];
        bool isSelected = IsSelected(r, c);
        bool sameRow = Sudoku.Selected?.Row == r;
        bool sameCol = Sudoku.Selected?.Col == c;
        bool hasConflict = view.Conflicts[r, c];
        bool sameBlock = false;
        bool sameValue = false;
        if (Sudoku.Selected is Position sp)
        {
            sameBlock = (r / 3 == sp.Row / 3) && (c / 3 == sp.Col / 3);
            var selectedVal = Sudoku.Current[sp.Row, sp.Col].Value;
            if (selectedVal is int sv && cell.Value is int cv && sv == cv)
            {
                sameValue = true;
            }
        }
        string borderClasses = (r % 3 == 0 ? " top3" : "") + (c % 3 == 0 ? " left3" : "") + (r == 8 ? " bottom3" : "") + (c == 8 ? " right3" : "");
        return $"cell{(cell.IsGiven ? " given" : "")}{(isSelected ? " selected" : "")}{(sameRow ? " rowhl" : "")}{(sameCol ? " colhl" : "")}{(sameBlock ? " blockhl" : "")}{(sameValue ? " valhl" : "")}{(hasConflict ? " conflict" : "")}{borderClasses}";
    }
}
